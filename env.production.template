# Production Environment Variables Template
# Copy this to .env.production and fill in your actual values

NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/totaggroup

# Session Configuration (Generate a secure random string)
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production

# Email Service
RESEND_API_KEY=your-resend-api-key

# PostgreSQL (for Docker)
POSTGRES_PASSWORD=your-secure-postgres-password

# Optional: SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem